---
import Wordmark from "./Wordmark.astro";
import Container from "./Container.astro";
import Privacy from "./Privacy.astro";
---

<footer class="bg-ink">
  <Container class="flex flex-col items-center justify-between gap-4 py-10 md:flex-row">
    <p class="text-surface text-3xl leading-[0.92] tracking-tight">
      <Wordmark />
    </p>
    <div
      class="text-surface/70 flex flex-wrap items-center justify-center gap-x-2 gap-y-2 md:justify-end"
    >
      <p class="text-surface/70">
        <a
          href="https://nicolamustone.com/"
          class="font-medium text-white hover:opacity-75 focus-visible:outline-2 focus-visible:outline-offset-4"
          >Designed in Italy</a
        >, without cream &middot; <a
          data-privacy-open
          class="cursor-pointer font-medium text-white hover:opacity-75"
          data-fathom-event="footer-privacy">Terms &amp; Privacy</a
        >
      </p>
      <span aria-hidden="true">&middot;</span>
      <span class="inline-flex items-center gap-1">
        Hosted at{" "}
        <a
          href="https://spacefast.com/"
          class="inline-flex text-white hover:opacity-75 focus-visible:outline-2 focus-visible:outline-offset-4"
        >
          <img
            src="/images/spacefast-wordmark.svg"
            alt="Spacefast"
            width="114"
            height="22"
            class="h-auto w-[114px] brightness-0 invert"
            loading="lazy"
          />
        </a>
      </span>
    </div>
  </Container>
</footer>
<Privacy />
